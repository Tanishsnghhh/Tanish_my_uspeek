# =============================================================================
# U-SPEAK PRO 4.4 - ESSENTIAL ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and update the values for your environment
# =============================================================================

# 🗄️ DATABASE CONFIGURATION
# Choose one of the following MongoDB connection options:

# Local MongoDB (Development)
MONGODB_URI=mongodb://localhost:27017/uspeak-pro


# Docker MongoDB (Using docker-compose.yml)
# MONGODB_URI=mongodb://admin:password123@localhost:27017/uspeak-pro?authSource=admin

# MongoDB Atlas (Production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/uspeak-pro?retryWrites=true&w=majority

# 🔐 AUTHENTICATION & SECURITY
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Next.js Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key

# 🏢 ACCESS CONTROL
ENABLE_ADMIN_CROSS_ACCOUNT=true
STRICT_ACCOUNT_ISOLATION=true
ADMIN_GLOBAL_ACCESS=true

# 🌐 CORS & API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# 🎛️ FEATURE FLAGS
ENABLE_FREQUENCY_DATA=true
ENABLE_ADVANCED_FILTERING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_WORK_REPORTS=true
ENABLE_BULK_ASSIGNMENTS=true

# 🚀 PERFORMANCE
AGGREGATION_TIMEOUT_MS=30000
AGGREGATION_ALLOW_DISK_USE=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

# 🔧 DEVELOPMENT
NODE_ENV=development
LOG_LEVEL=info

# 🧪 TEST DATA (Development Only - Remove in Production)
DEV_ACCOUNT_ID=68a9866757aef17c0b766996
DEV_USER_ID=68a9866857aef17c0b766998
DEV_INSTANCE_ID=68ad4ff9e8e7313146f6a6d1

# 📧 EMAIL (Optional - Configure if using email features)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# 🔌 THIRD-PARTY (Optional)
# SYNCFUSION_LICENSE_KEY=your-syncfusion-license-key
