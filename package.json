{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "node setup.js",
    "setup:auto": "./setup.sh",
    "setup:backend": "cd main && python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt",
    "setup:frontend": "npm install",
    "setup:env": "cp env.example .env.local && echo 'Environment file created. Please edit .env.local with your configuration.'",
    "start:dev": "./start-dev.sh",
    "start:django": "cd main && source venv/bin/activate && python manage.py runserver 8000",
    "start:both": "concurrently \"npm run start:django\" \"npm run dev\"",
    "migrate": "cd main && source venv/bin/activate && python manage.py migrate",
    "makemigrations": "cd main && source venv/bin/activate && python manage.py makemigrations",
    "createsuperuser": "cd main && source venv/bin/activate && python manage.py createsuperuser",
    "collectstatic": "cd main && source venv/bin/activate && python manage.py collectstatic --noinput",
    "test:frontend": "npm test",
    "test:backend": "cd main && source venv/bin/activate && python manage.py test",
    "test:all": "npm run test:frontend && npm run test:backend",
    "clean": "rm -rf node_modules main/venv .next main/__pycache__ main/*/__pycache__",
    "clean:install": "npm run clean && npm install && npm run setup:backend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
