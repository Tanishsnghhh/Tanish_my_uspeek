pipeline {
    agent any

    tools {
        // Requires 'maven' to be configured in Jenkins Global Tool Configuration
        maven 'maven' 
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Start Dev Server') {
            steps {
                dir('selenium-jenkins-testing') {
                    echo 'Starting Next.js Server in background...'
                    sh 'npm install'
                    sh 'nohup npm run dev > server.log 2>&1 &'
                    sleep time: 10, unit: 'SECONDS'
                }
            }
        }
        
        stage('Run Java Selenium Tests') {
            steps {
                dir('selenium-jenkins-testing') {
                    echo 'Running Maven Testing Pipeline...'
                    sh 'mvn clean test'
                }
            }
        }
    }

    post {
        always {
            echo 'Shutting down Next.js Server...'
            sh "pkill -f 'next dev' || true"
        }
        success {
            echo '✅ All tests passed successfully!'
        }
        failure {
            echo '❌ Tests failed. Please check the logs.'
        }
    }
}